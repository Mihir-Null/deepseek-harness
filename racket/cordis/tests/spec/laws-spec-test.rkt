#lang racket/base
;; The laws of docs/racket/recon/19-paper-digest.md, "Laws an implementation
;; should test", as executable properties of the kernel. This file holds laws
;; 1, 4, 5, 7, 8, 10 to 17 and 22 to 35. Laws 2, 3, 6 and 9 are in
;; effect-spec-test.rkt; laws 18 to 21 and 36 to 39 are the randomized
;; schedules of schedules-spec-test.rkt.
;;
;; Observations go through public operations only: kernel-snapshot, fiber
;; states, ctx-get and ctx-ref, and logs written by plugin bodies and inverses.
(require cordis
         cordis/testing
         rackunit
         racket/generator
         racket/list
         "support.rkt")

(define (try-ref c key)
  (with-handlers ([exn:fail? values]) (ctx-ref c key)))

(define (index-of-note log v)
  (index-of (notes log) v))

;; Records every 'internal/status change of fibers accepted by `pred` as (old . new).
(define (record-status-of! ctx pred log)
  (ctx-on ctx 'internal/status
          (lambda (f old) (when (pred f) (note! log (cons old (fiber-state f)))))))

;; source: digest law 1 (Definitions 1, 3; Theorem 16)
(test-case "law 1: an effect runs its collected disposers in reverse order"
  (with-root (ctx)
    (define log (make-recorder))
    (define n 6)
    (define d (ctx-effect ctx (lambda ()
                                (for/list ([i (in-range n)]) (lambda () (note! log i))))))
    (d)
    (check-equal? (notes log) (reverse (range n)))))

;; source: digest law 4 (Theorem 7); analysis law 1 (reversal)
(test-case "law 4: unloading a fiber restores the observation it started from"
  (with-root (ctx)
    (ctx-provide ctx 'base (hasheq 'member 'value))
    (define before (kernel-snapshot ctx))
    (define table (make-hasheq))
    (define f
      (ctx-plugin
       ctx
       (make-plugin
        (lambda (c config)
          (ctx-on c 'law4/event void)
          (ctx-on c 'law4/other void #:prepend? #t)
          (ctx-provide c 'law4-service 'value)
          (ctx-provide (context-isolate c 'law4-private) 'law4-private 'hidden)
          (ctx-accessor c 'law4-accessor #:get (lambda (reader) 'computed))
          (ctx-mixin c 'base '(member))
          (ctx-effect c (lambda ()
                          (hash-set! table 'entry #t)
                          (lambda () (hash-remove! table 'entry))))
          (ctx-plugin c (make-plugin (lambda (cc config) (ctx-on cc 'law4/child void) (void))
                                     #:name "law4-child"))
          (void))
        #:name "law4-plugin")))
    (await f)
    (settle-all (ctx-fibers ctx))
    (check-false (equal? (kernel-snapshot ctx) before))
    (check-equal? (hash-count table) 1)
    (fiber-dispose! f)
    (check-equal? (kernel-snapshot ctx) before)
    (check-equal? (hash-count table) 0)))

;; source: digest law 4, through the cordis/testing helper (contract 10)
(test-case "law 4: check-kernel-restored accepts a mount followed by a dispose"
  (with-root (ctx)
    (check-kernel-restored
     (lambda ()
       (define f (ctx-plugin ctx (lambda (c config)
                                   (ctx-on c 'law4/event void)
                                   (ctx-provide c 'law4-service 1)
                                   (void))))
       (await f)
       (fiber-dispose! f))
     ctx)))

;; source: digest law 5 (Theorem 10)
(test-case "law 5: an empty effect and a no-op disposer are accepted and dispose cleanly"
  (with-root (ctx)
    (define rf (context-fiber ctx))
    (define before (labels-of rf))
    (define empty (ctx-effect ctx (lambda () (void)) #:label "empty"))
    (define no-op (ctx-effect ctx (lambda () (lambda () (void))) #:label "no-op"))
    (check-equal? (labels-of rf) (append before '("empty" "no-op")))
    (check-equal? (empty) (void))
    (check-equal? (no-op) (void))
    (check-equal? (labels-of rf) before)))

;; source: digest law 7
(test-case "law 7: calling a disposer twice has the effect of calling it once"
  (with-root (ctx)
    (define counter 0)
    (define table (make-hasheq))
    (define d (ctx-effect ctx (lambda ()
                                (hash-set! table 'k 'v)
                                (lambda ()
                                  (set! counter (add1 counter))
                                  (hash-remove! table 'k)))))
    (d)
    (define after-once (list counter (hash-copy table)))
    (d)
    (dispose! d)
    (check-equal? (list counter (hash-copy table)) after-once)
    (check-equal? counter 1)))

;; source: digest law 8 (Definition 18; Algorithm 1); contract 4 rule 9 (plugin
;; body guard: the fiber's target is unchanged)
(test-case "law 8: a target change stops an effect iterator after k of n yields"
  (with-root (ctx)
    (define n 5)
    (define k 3)
    (define log (make-recorder))
    (define reached (make-gate))
    (define gate (make-gate))
    (define f
      (ctx-plugin ctx
                  (lambda (c config)
                    (generator ()
                      (for ([i (in-range 1 (add1 n))])
                        (when (= i k)
                          (gate-open! reached)
                          (gate-wait gate))
                        (note! log (list 'step i))
                        (yield (lambda () (note! log (list 'inverse i)))))
                      (void)))))
    (gate-wait reached)
    (define disposing (spawn-task (lambda () (fiber-dispose! f))))
    (check-true (yield-until (lambda () (not (fiber-uid f)))))
    (gate-open! gate)
    (await disposing)
    (check-equal? (notes log)
                  '((step 1) (step 2) (step 3) (inverse 3) (inverse 2) (inverse 1)))
    (check-eq? (fiber-state f) 'disposed)))

;; source: digest law 10 (Definitions 12, 28)
(test-case "law 10: a parent effect and a fiber dispose what was registered inside them"
  (with-root (ctx)
    (define log (make-recorder))
    (define (tracked c tag)
      (ctx-effect c (lambda () (lambda () (note! log tag)))))
    (define parent
      (ctx-effect ctx (lambda () (list (tracked ctx 'inner-1) (tracked ctx 'inner-2)))))
    (parent)
    (check-equal? (notes log) '(inner-2 inner-1))
    ;; Effects registered through contexts derived from a fiber's context
    ;; belong to that fiber.
    (define f (ctx-plugin ctx (lambda (c config)
                                (tracked (context-extend c (hasheq 'k 'v)) 'extended)
                                (tracked (context-isolate c 'some-service) 'isolated)
                                (tracked (context-intercept c 'some-service (hasheq)) 'intercepted)
                                (ctx-on (context-extend c (hasheq)) 'law10/event void)
                                (void))))
    (await f)
    (check-equal? (length (fiber-effects f)) 4)
    (fiber-dispose! f)
    (check-equal? (sort (drop (notes log) 2) symbol<?) '(extended intercepted isolated))
    (check-equal? (ctx-listeners ctx 'law10/event) '())))

;; source: digest law 11 (Definition 19)
(test-case "law 11: a double provision raises and leaves the first binding intact"
  (with-root (ctx)
    (define first-provider
      (ctx-plugin ctx (make-plugin (lambda (c config) (ctx-provide c 'law11 'first) (void))
                                   #:name "first-provider")))
    (await first-provider)
    (define consumer (ctx-inject ctx '(law11) void))
    (await consumer)
    (define second-provider
      (ctx-plugin ctx (lambda (c config) (ctx-provide c 'law11 'second) (void))))
    (settle second-provider)
    (check-eq? (fiber-state second-provider) 'failed)
    (check-pred exn:fail:cordis:service? (fiber-error second-provider))
    (check-eq? (ctx-get ctx 'law11) 'first)
    (check-eq? (fiber-state consumer) 'active)
    (check-eq? (ctx-ref (fiber-context consumer) 'law11) 'first)
    (check-equal? (fiber-provisions second-provider) '())))

;; source: digest law 12 (Definition 20; Algorithm 2)
(test-case "law 12: provide then dispose leaves the key absent and notifies at both changes"
  (with-root (ctx)
    (define before (kernel-snapshot ctx))
    (define transitions (make-recorder))
    (define consumer (ctx-inject ctx '(law12) void))
    (record-status-of! ctx (lambda (f) (eq? f consumer)) transitions)
    (define after-consumer (kernel-snapshot ctx))
    (define d (ctx-provide ctx 'law12 'value))
    (await consumer)
    (d)
    (settle consumer)
    (check-false (ctx-has? ctx 'law12))
    (check-false (ctx-get ctx 'law12 #:strict? #f))
    (check-equal? (kernel-snapshot ctx) after-consumer)
    (check-false (equal? after-consumer before))
    (check-equal? (notes transitions)
                  '((pending . loading) (loading . active)
                    (active . unloading) (unloading . pending)))))

;; source: digest law 13 (Algorithm 6)
(test-case "law 13: absent get is silent; undeclared and uncommitted reads raise differently"
  (with-root (ctx)
    (define f (ctx-inject ctx '(declared) void))
    (define fc (fiber-context f))
    (check-false (ctx-get fc 'declared))
    (check-false (ctx-get fc 'undeclared))
    (define undeclared (try-ref fc 'undeclared))
    (define uncommitted (try-ref fc 'declared))
    (check-pred exn:fail:cordis:inject? undeclared)
    (check-pred exn:fail:cordis:inject? uncommitted)
    (check-regexp-match #rx"without inject" (exn-message undeclared))
    (check-regexp-match #rx"in inactive context" (exn-message uncommitted))
    (check-false (equal? (exn-message undeclared) (exn-message uncommitted)))))

;; source: digest law 14 (Definition 22)
(test-case "law 14: apply and unload run exactly at changes of satisfaction"
  (with-root (ctx)
    (define applies 0)
    (define unloads 0)
    (define f (ctx-inject ctx '(needed)
                          (lambda (c)
                            (set! applies (add1 applies))
                            (lambda () (set! unloads (add1 unloads))))))
    (define (counts) (settle f) (yield-times 3) (settle f) (list applies unloads))
    (define unrelated (ctx-provide ctx 'unrelated 1))
    (check-equal? (counts) '(0 0))
    (define d (ctx-provide ctx 'needed 1))
    (check-equal? (counts) '(1 0))
    ;; Changes at an undeclared key and an in-place overwrite cause neither.
    (unrelated)
    (ctx-provide ctx 'another 2)
    (ctx-set! ctx 'needed 2)
    (check-equal? (counts) '(1 0))
    (d)
    (check-equal? (counts) '(1 1))
    (ctx-provide ctx 'needed 3)
    (check-equal? (counts) '(2 1))))

;; source: digest law 15 (Definitions 24, 25; Algorithm 3); analysis law 11
(test-case "law 15: realms are independent and notifications stay inside a realm"
  (with-root (ctx)
    (ctx-provide ctx 'law15 'shared)
    (ctx-provide ctx 'law15-plain 'plain)
    (define iso (context-isolate ctx 'law15))
    (define shared-consumer (ctx-inject ctx '(law15) void))
    (define isolated-consumer (ctx-inject iso '(law15) void))
    (await shared-consumer)
    (settle isolated-consumer)
    ;; isolate on a child does not change what the parent resolves
    (check-eq? (ctx-get ctx 'law15) 'shared)
    (check-false (ctx-get iso 'law15))
    ;; a key that was never isolated resolves in the shared realm
    (check-eq? (ctx-get iso 'law15-plain) 'plain)
    (check-eq? (fiber-state isolated-consumer) 'pending)
    (define transitions (make-recorder))
    (record-status-of! ctx (lambda (f) (eq? f shared-consumer)) transitions)
    (define d (ctx-provide iso 'law15 'private))
    (await isolated-consumer)
    (check-eq? (ctx-get iso 'law15) 'private)
    (check-eq? (ctx-get ctx 'law15) 'shared)
    (check-eq? (ctx-ref (fiber-context isolated-consumer) 'law15) 'private)
    (check-eq? (ctx-ref (fiber-context shared-consumer) 'law15) 'shared)
    (d)
    (settle isolated-consumer)
    (check-eq? (fiber-state isolated-consumer) 'pending)
    ;; the shared-realm consumer was never notified into a transition
    (check-equal? (notes transitions) '())
    (check-eq? (fiber-state shared-consumer) 'active)))

;; source: digest law 16 (Definition 27; section 6.3). The digest lets
;; context-carried metadata win; the vendored code gives the plugin's own
;; inject value the last word, and the port follows the code (analysis 3.1).
(test-case "law 16: interception merges metadata and triggers no lifecycle transition"
  (with-root (ctx)
    (ctx-provide ctx 'law16 'value)
    (define transitions (make-recorder))
    (define outer (context-intercept ctx 'law16 (hasheq 'level 'context 'origin 'context)))
    (define f
      (ctx-plugin outer (make-plugin (lambda (c config) (void))
                                     #:name "law16-consumer"
                                     #:inject (hasheq 'law16 (hasheq 'level 'declared)))))
    (await f)
    (record-status-of! ctx (lambda (fiber) #t) transitions)
    (define merged (service-resolve-config (fiber-context f) 'law16))
    (check-eq? (hash-ref merged 'origin) 'context)
    (check-eq? (hash-ref merged 'level) 'declared)
    ;; Adding, changing and dropping interception is context derivation only.
    (define added (context-intercept (fiber-context f) 'law16 (hasheq 'level 'added)))
    (define changed (context-intercept added 'law16 (hasheq 'level 'changed)))
    (check-eq? (hash-ref (service-resolve-config changed 'law16) 'level) 'changed)
    (check-eq? (hash-ref (service-resolve-config (fiber-context f) 'law16) 'level) 'declared)
    (yield-times 5)
    (check-equal? (notes transitions) '())
    (check-eq? (fiber-state f) 'active)))

;; source: digest law 17 (paper:6477-6483); analysis law 7
(test-case "law 17: a new provider of an equal value reloads dependents; an overwrite does not"
  (with-root (ctx)
    (define applies (make-recorder))
    (define (provider)
      (ctx-plugin ctx (lambda (c config) (ctx-provide c 'law17 "equal value") (void))))
    (define p1 (provider))
    (await p1)
    (define consumer
      (ctx-inject ctx '(law17) (lambda (c) (note! applies (ctx-ref c 'law17)) (void))))
    (await consumer)
    (ctx-set! (fiber-context p1) 'law17 "overwritten")
    (yield-times 5)
    (settle consumer)
    (check-equal? (notes applies) '("equal value"))
    (ctx-set! (fiber-context p1) 'law17 "equal value")
    (fiber-dispose! p1)
    (settle consumer)
    (check-eq? (fiber-state consumer) 'pending)
    (define p2 (provider))
    (await p2)
    (await consumer)
    (check-equal? (notes applies) '("equal value" "equal value"))
    (check-eq? (fiber-state consumer) 'active)))

;; source: digest law 22 (Theorem 70)
(test-case "law 22: apply never starts while a declared key lacks an active provider"
  (with-root (ctx)
    (define gate (make-gate))
    (define provided (make-gate))
    (define observed (make-recorder))
    (define provider
      (ctx-plugin ctx (lambda (c config)
                        (ctx-provide c 'law22-slow 'slow)
                        (gate-open! provided)
                        (gate-wait gate)
                        (void))))
    (define consumer
      (ctx-inject ctx '(law22-slow law22-fast)
                  (lambda (c)
                    (note! observed (list (fiber-state provider)
                                          (ctx-get c 'law22-slow)
                                          (ctx-get c 'law22-fast))))))
    (gate-wait provided)
    (ctx-provide ctx 'law22-fast 'fast)
    (yield-times 5)
    (check-eq? (fiber-state consumer) 'pending)
    (check-equal? (notes observed) '())
    (gate-open! gate)
    (await provider)
    (await consumer)
    (check-equal? (notes observed) '((active slow fast)))))

;; source: digest law 23 (Theorem 70(2)); analysis law 8
(test-case "law 23: no provider disposer runs before every committed consumer has unloaded"
  (with-root (ctx)
    (define log (make-recorder))
    (define provider
      (ctx-plugin ctx (lambda (c config)
                        (ctx-provide c 'law23 'value)
                        (ctx-effect c (lambda () (lambda () (note! log 'provider-effect))))
                        (lambda () (note! log 'provider-returned)))))
    (await provider)
    (define consumers
      (for/list ([i (in-range 3)])
        (ctx-inject ctx '(law23)
                    (lambda (c)
                      (lambda ()
                        (yield-times (* 2 (add1 i)))
                        (note! log (list 'consumer-unloaded i)))))))
    (for-each await consumers)
    (fiber-dispose! provider)
    (settle-all consumers)
    (define first-provider-step
      (min (index-of-note log 'provider-effect) (index-of-note log 'provider-returned)))
    (for ([i (in-range 3)])
      (check-true (< (index-of-note log (list 'consumer-unloaded i)) first-provider-step)))
    (check-equal? (length (notes log)) 5)))

;; source: digest law 24 (Theorem 70(3); Algorithm 6)
(test-case "law 24: a consumer's disposer can still read the provider that is being disposed"
  (with-root (ctx)
    (define read-during-teardown (box 'not-run))
    (define provider
      (ctx-plugin ctx (lambda (c config) (ctx-provide c 'law24 'still-here) (void))))
    (await provider)
    (define consumer
      (ctx-inject ctx '(law24)
                  (lambda (c)
                    (lambda ()
                      (yield-task)
                      (set-box! read-during-teardown (try-ref c 'law24))))))
    (await consumer)
    (fiber-dispose! provider)
    (settle consumer)
    (check-eq? (unbox read-during-teardown) 'still-here)
    (check-false (ctx-get ctx 'law24 #:strict? #f))))

;; source: digest law 25 (L-Leave; paper:6322-6327)
(test-case "law 25: a leaving provider is out of service before its own disposers run"
  (with-root (ctx)
    (define log (make-recorder))
    (define blocked (make-gate))
    (define release (make-gate))
    (define provider
      (ctx-plugin ctx (lambda (c config)
                        (ctx-provide c 'law25 'value)
                        (lambda () (note! log 'provider-disposer)))))
    (await provider)
    (define consumer
      (ctx-inject ctx '(law25)
                  (lambda (c)
                    (lambda ()
                      (gate-open! blocked)
                      (gate-wait release)
                      (note! log 'consumer-disposer)))))
    (await consumer)
    (define disposing (spawn-task (lambda () (fiber-dispose! provider))))
    (gate-wait blocked)
    (check-eq? (fiber-state provider) 'unloading)
    (check-eq? (fiber-state consumer) 'unloading)
    (check-equal? (notes log) '())
    ;; A consumer mounted now must not activate against the leaving provider.
    (define late-runs 0)
    (define late (ctx-inject ctx '(law25) (lambda (c) (set! late-runs (add1 late-runs)))))
    (yield-times 5)
    (check-eq? (fiber-state late) 'pending)
    (check-false (ctx-get ctx 'law25))
    (gate-open! release)
    (await disposing)
    (settle-all (list consumer late))
    (check-equal? (notes log) '(consumer-disposer provider-disposer))
    (check-equal? late-runs 0)
    (check-eq? (fiber-state late) 'pending)))

;; source: digest law 26 (Theorem 71)
(test-case "law 26: a consumer caught mid-apply never turns active against the old provider"
  (with-root (ctx)
    (define log (make-recorder))
    (define in-apply (make-gate))
    (define gate (make-gate))
    (define (provider value)
      (ctx-plugin ctx (lambda (c config) (ctx-provide c 'law26 value) (void))))
    (define old-provider (provider 'old))
    (await old-provider)
    (define transitions (make-recorder))
    (define first-apply? #t)
    (define consumer
      (ctx-plugin ctx
                  (make-plugin
                   (lambda (c config)
                     (define seen (ctx-ref c 'law26))
                     (note! log (list 'apply seen))
                     (ctx-effect c (lambda () (lambda () (note! log (list 'reverted seen)))))
                     (when first-apply?
                       (set! first-apply? #f)
                       (gate-open! in-apply)
                       (gate-wait gate))
                     (void))
                   #:name "law26-consumer"
                   #:inject '(law26))))
    (record-status-of! ctx (lambda (f) (eq? f consumer)) transitions)
    (gate-wait in-apply)
    (define replacing
      (spawn-task (lambda ()
                    (fiber-dispose! old-provider)
                    (provider 'new))))
    (check-true (yield-until (lambda () (not (fiber-uid old-provider)))))
    (check-eq? (fiber-state consumer) 'loading)
    (gate-open! gate)
    (define new-provider (await replacing))
    (await new-provider)
    (await consumer)
    (check-equal? (notes log) '((apply old) (reverted old) (apply new)))
    (check-equal? (notes transitions)
                  '((loading . unloading) (unloading . pending)
                    (pending . loading) (loading . active)))
    (check-eq? (ctx-ref (fiber-context consumer) 'law26) 'new)))

;; source: digest law 27 (section 4.4; Algorithm 5); analysis law 9
(test-case "law 27: toggling a dependency during a slow load never overlaps transitions"
  (with-root (ctx)
    (define in-flight 0)
    (define overlap? #f)
    (define applies (make-recorder))
    (define in-apply (make-gate))
    (define gate (make-gate))
    (define (enter!) (set! in-flight (add1 in-flight)) (when (> in-flight 1) (set! overlap? #t)))
    (define (leave!) (set! in-flight (sub1 in-flight)))
    (define d1 (ctx-provide ctx 'law27 1))
    (define slow? #t)
    (define consumer
      (ctx-inject ctx '(law27)
                  (lambda (c)
                    (enter!)
                    (note! applies (ctx-ref c 'law27))
                    (when slow?
                      (set! slow? #f)
                      (gate-open! in-apply)
                      (gate-wait gate))
                    (leave!)
                    (lambda () (enter!) (yield-task) (leave!)))))
    (gate-wait in-apply)
    ;; off, on, off, on while the first activation is still loading
    (define withdraw-1 (spawn-task (lambda () (d1))))
    (check-true (yield-until (lambda () (not (ctx-has? ctx 'law27)))))
    (define d2 (ctx-provide ctx 'law27 2))
    (d2)
    (ctx-provide ctx 'law27 3)
    (yield-times 5)
    (check-eq? (fiber-state consumer) 'loading)
    (check-equal? (notes applies) '(1))
    (gate-open! gate)
    (await withdraw-1)
    (await consumer)
    (check-false overlap?)
    (check-equal? (notes applies) '(1 3))
    (check-eq? (fiber-state consumer) 'active)
    (check-eqv? (ctx-ref (fiber-context consumer) 'law27) 3)))

;; source: digest law 28 (Corollary 69)
(test-case "law 28: after a fiber unloads it provides no keys and holds no effects"
  (with-root (ctx)
    (define d (ctx-provide ctx 'law28-dependency 1))
    (define f (ctx-inject ctx '(law28-dependency)
                          (lambda (c)
                            (ctx-provide c 'law28-a 1)
                            (ctx-provide c 'law28-b 2)
                            (ctx-on c 'law28/event void)
                            (void))))
    (await f)
    (check-equal? (sort (fiber-provisions f) symbol<?) '(law28-a law28-b))
    (d)
    (settle f)
    (check-eq? (fiber-state f) 'pending)
    (check-equal? (fiber-provisions f) '())
    (check-equal? (fiber-effects f) '())
    (check-false (ctx-has? ctx 'law28-a))
    (check-equal? (ctx-listeners ctx 'law28/event) '())))

;; source: digest law 29 (Definition 52); analysis law 10
(test-case "law 29: children created during apply are gone after the parent unloads"
  (with-root (ctx)
    (define children (make-recorder))
    (define parent
      (ctx-plugin ctx (lambda (c config)
                        (note! children
                               (ctx-plugin c (lambda (cc config)
                                               (note! children
                                                      (ctx-plugin cc (lambda (gc config) (void))))
                                               (void))))
                        (void))))
    (await parent)
    (settle-all (ctx-fibers ctx))
    (define first-generation (notes children))
    (check-equal? (length first-generation) 2)
    (fiber-restart! parent)
    (settle-all (ctx-fibers ctx))
    (check-equal? (map fiber-state first-generation) '(disposed disposed))
    (check-equal? (length (notes children)) 4)
    (check-equal? (length (ctx-fibers ctx)) 3)
    (fiber-dispose! parent)
    (check-equal? (map fiber-state (notes children)) '(disposed disposed disposed disposed))
    (check-equal? (ctx-fibers ctx) '())))

;; source: digest law 30 (Lemma 59(5); section 4.4 Configuration)
(test-case "law 30: a disposed fiber stays retired when its dependencies reappear"
  (with-root (ctx)
    (define runs 0)
    (define p (make-plugin (lambda (c config) (set! runs (add1 runs)) (void))
                           #:inject '(law30)))
    (define d (ctx-provide ctx 'law30 1))
    (define f (ctx-plugin ctx p))
    (await f)
    (define old-uid (fiber-uid f))
    (fiber-dispose! f)
    (d)
    (ctx-provide ctx 'law30 2)
    (yield-times 5)
    (check-eq? (fiber-state f) 'disposed)
    (check-equal? runs 1)
    (define again (ctx-plugin ctx p))
    (await again)
    (check-false (eq? again f))
    (check-true (> (fiber-uid again) old-uid))
    (check-equal? runs 2)))

;; source: digest law 31 (O-Remove). The kernel detaches a fiber from the
;; registry when disposal starts (fiber.ts disposer), so the law is checked on
;; what holds when the dispose call returns and on the order of final states.
(test-case "law 31: a removed fiber holds nothing and its children finish before it"
  (with-root (ctx)
    (define finished (make-recorder))
    (ctx-on ctx 'internal/status
            (lambda (f old)
              (when (eq? (fiber-state f) 'disposed) (note! finished f))))
    (define child (box #f))
    (define parent
      (ctx-plugin ctx (lambda (c config)
                        (ctx-provide c 'law31 1)
                        (set-box! child (ctx-plugin c (lambda (cc config)
                                                        (ctx-on cc 'law31/event void)
                                                        (void))))
                        (void))))
    (await parent)
    (await (unbox child))
    (fiber-dispose! parent)
    (define order (notes finished))
    (check-equal? order (list (unbox child) parent))
    (for ([f (in-list order)])
      (check-eq? (fiber-state f) 'disposed)
      (check-equal? (fiber-effects f) '())
      (check-equal? (fiber-provisions f) '())
      (check-false (memq f (ctx-fibers ctx))))))

;; source: digest law 32 (section 4.4 Failure)
(test-case "law 32: a failing apply is contained to its own fiber"
  (with-root (ctx)
    (define before (kernel-snapshot ctx))
    (define sibling-runs 0)
    (define failing (box #f))
    (define parent
      (ctx-plugin ctx (make-plugin
                       (lambda (c config)
                         (ctx-plugin c (make-plugin (lambda (cc config)
                                                      (set! sibling-runs (add1 sibling-runs))
                                                      (void))
                                                    #:name "law32-sibling"))
                         (set-box! failing
                                   (ctx-plugin c (make-plugin
                                                  (lambda (cc config)
                                                    (ctx-on cc 'law32/event void)
                                                    (ctx-provide cc 'law32-service 1)
                                                    (raise-user-error "law 32 failure"))
                                                  #:name "law32-failing")))
                         (void))
                       #:name "law32-parent")))
    (await parent)
    (settle-all (ctx-fibers ctx))
    (define f (unbox failing))
    (check-eq? (fiber-state f) 'failed)
    (check-equal? (fiber-effects f) '())
    (check-equal? (fiber-provisions f) '())
    (check-equal? (ctx-listeners ctx 'law32/event) '())
    (check-false (ctx-has? ctx 'law32-service))
    (check-eq? (fiber-state parent) 'active)
    (check-equal? sibling-runs 1)
    (check-equal? (map fiber-state (ctx-fibers ctx)) '(active active failed))
    (fiber-dispose! parent)
    (check-equal? (kernel-snapshot ctx) before)))

;; source: digest law 33 (section 6.5)
(test-case "law 33: a dependency cycle stays inactive without error or blocking"
  (with-root (ctx)
    (define runs 0)
    (define (cyclic needs gives)
      (ctx-plugin ctx (make-plugin (lambda (c config)
                                     (set! runs (add1 runs))
                                     (ctx-provide c gives 'value)
                                     (void))
                                   #:inject (list needs))))
    (define a (cyclic 'law33-b 'law33-a))
    (define b (cyclic 'law33-a 'law33-b))
    (define unrelated (ctx-plugin ctx (lambda (c config) (void))))
    (check-eq? (await unrelated) unrelated)
    (check-eq? (await a) a)
    (check-eq? (await b) b)
    (check-equal? (map fiber-state (list a b unrelated)) '(pending pending active))
    (check-false (fiber-error a))
    (check-false (fiber-error b))
    (check-equal? runs 0)
    (fiber-dispose! a)
    (fiber-dispose! b)))

;; source: digest law 34 (Lemma 61)
(test-case "law 34: observations do not depend on the uid allocation"
  (define (scenario warm-up)
    (with-root (ctx)
      (for ([i (in-range warm-up)])
        (define d (ctx-provide ctx 'law34-warm-up i))
        (define f (ctx-plugin ctx (lambda (c config) (void))))
        (await f)
        (fiber-dispose! f)
        (d))
      (define log (make-recorder))
      (define provider
        (ctx-plugin ctx (make-plugin (lambda (c config) (ctx-provide c 'law34 'value) (void))
                                     #:name "law34-provider")))
      (define consumer
        (ctx-plugin ctx (make-plugin (lambda (c config)
                                       (note! log (ctx-ref c 'law34))
                                       (ctx-on c 'law34/event void)
                                       (void))
                                     #:name "law34-consumer"
                                     #:inject '(law34))))
      (await provider)
      (await consumer)
      (fiber-restart! provider)
      (settle consumer)
      (list (kernel-snapshot ctx)
            (map fiber-state (list provider consumer))
            (notes log)
            (fiber-uid consumer))))
  (define plain (scenario 0))
  (define shifted (scenario 7))
  (check-equal? (take plain 3) (take shifted 3))
  (check-false (equal? (fourth plain) (fourth shifted))))

;; source: digest law 35 (Lemma 62)
(test-case "law 35: a disposed fiber that is still referenced does not affect resolution"
  (with-root (ctx)
    (define retired
      (ctx-plugin ctx (lambda (c config) (ctx-provide c 'law35 'retired-value) (void))))
    (await retired)
    (define retired-ctx (fiber-context retired))
    (fiber-dispose! retired)
    (check-false (ctx-has? ctx 'law35))
    (check-false (ctx-get retired-ctx 'law35 #:strict? #f))
    (define consumer (ctx-inject ctx '(law35) void))
    (settle consumer)
    (check-eq? (fiber-state consumer) 'pending)
    (define replacement
      (ctx-plugin ctx (lambda (c config) (ctx-provide c 'law35 'live-value) (void))))
    (await replacement)
    (await consumer)
    (check-eq? (ctx-get ctx 'law35) 'live-value)
    (check-eq? (ctx-get retired-ctx 'law35) 'live-value)
    (check-eq? (ctx-ref (fiber-context consumer) 'law35) 'live-value)
    (check-eq? (fiber-state retired) 'disposed)
    (check-equal? (fiber-provisions retired) '())))
