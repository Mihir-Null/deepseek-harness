#lang racket/base
;; Contexts: contract section 3. Derivation, lookup, the root, disposal and shutdown, and
;; the loader-support module with its rebindable contexts.
(require rackunit
         racket/list
         cordis
         cordis/testing
         cordis/private/loader-support
         "common.rkt")

(test-case "root: the root context owns an active root fiber with uid 0"
  (with-root-context (ctx)
    (define rf (context-fiber ctx))
    (check-true (context? ctx))
    (check-false (context? rf))
    (check-true (root-context? ctx))
    (check-eq? (context-root ctx) ctx)
    (check-false (context-parent ctx))
    (check-true (fiber? rf))
    (check-eq? (fiber-state rf) 'active)
    (check-equal? (fiber-uid rf) 0)
    (check-equal? (fiber-name rf) "root")
    (check-false (fiber-plugin rf))
    (check-false (fiber-parent rf))
    (check-eq? (fiber-context rf) ctx)
    (check-equal? (hash-count (fiber-inject rf)) 0)
    (check-equal? (fiber-committed rf) (hasheq))
    (check-equal? (fiber-effects rf) '())
    (check-true (scheduler? (context-scheduler ctx)))
    (check-true (custodian? (context-custodian ctx)))
    (check-true (in-task? (context-scheduler ctx)))
    (check-equal? (ctx-fibers ctx) '())))

(test-case "root: #:scheduler shares a scheduler; #:custodian owns the kernel"
  (define cust (make-custodian))
  (define s (make-scheduler #:custodian cust))
  (define root (make-root-context #:name 'shared #:scheduler s #:custodian cust))
  (check-eq? (context-scheduler root) s)
  (define other (make-root-context #:scheduler s #:custodian cust))
  (ctx-provide root 'db 1)
  (check-true (ctx-has? root 'db))
  (check-false (ctx-has? other 'db))
  ;; a scheduler the root did not create survives the root's shutdown
  (context-shutdown! root)
  (check-equal? (call-in-kernel (lambda () 'still-running) #:scheduler s) 'still-running)
  (context-shutdown! other)
  (custodian-shutdown-all cust))

(test-case "derivation: contexts are values; children do not change their parents"
  (with-root-context (ctx)
    (define extended (context-extend ctx (hasheq 'a 1 'b 2)))
    (define shadowed (context-extend extended (hash "a" 10)))
    (check-false (eq? extended ctx))
    (check-false (root-context? extended))
    (check-eq? (context-root shadowed) ctx)
    (check-eq? (context-parent extended) ctx)
    (check-eq? (context-parent shadowed) extended)
    (check-eq? (context-fiber shadowed) (context-fiber ctx))
    (check-equal? (context-meta extended 'a) 1)
    (check-equal? (context-meta shadowed 'a) 10)
    (check-equal? (context-meta shadowed "b") 2)
    (check-false (context-meta ctx 'a))
    (check-equal? (context-meta ctx 'a 'default) 'default)
    (check-equal? (context-meta shadowed 'missing 'default) 'default)))

(test-case "derivation: a fiber's context inherits meta, realms and intercepts of its ancestors"
  ;; contract section 12, item 3
  (with-root-context (ctx)
    (define realm (make-realm 'db))
    (define mounted-on
      (context-intercept (context-isolate (context-extend ctx (hasheq 'loader/entry-id "row-1"))
                                          'db realm)
                         'db (hasheq 'layer 'outer)))
    (define child #f)
    (define parent
      (ctx-plugin mounted-on
                  (lambda (c config)
                    (set! child (ctx-plugin (context-extend c (hasheq 'depth 2))
                                            (make-plugin (lambda (c config) (void))
                                                         #:inject (hasheq 'db (hasheq 'layer 'own)))))
                    (ctx-provide c 'db 'scoped))))
    (await/t parent)
    (await/t child)
    (define pc (fiber-context parent))
    (define cc (fiber-context child))
    (check-eq? (context-parent pc) mounted-on)
    (check-equal? (context-meta pc 'loader/entry-id) "row-1")
    (check-equal? (context-meta cc 'loader/entry-id) "row-1")
    (check-equal? (context-meta cc 'depth) 2)
    (check-false (context-meta pc 'depth))
    (check-eq? (context-realm pc 'db) realm)
    (check-eq? (context-realm cc 'db) realm)
    (check-equal? (context-intercepts pc 'db) (list (hasheq 'layer 'outer)))
    (check-equal? (context-intercepts cc 'db) (list (hasheq 'layer 'outer) (hasheq 'layer 'own)))
    ;; the service lives in the inherited realm only
    (check-equal? (ctx-ref cc 'db) 'scoped)
    (check-false (ctx-has? ctx 'db))))

(test-case "isolate: a child realm, a joined realm, and the unchanged parent"
  (with-root-context (ctx)
    (ctx-provide ctx 'db 'shared)
    (define shared-realm (context-realm ctx 'db))
    (define a (context-isolate ctx 'db))
    (define b (context-isolate ctx "db" (context-realm a 'db)))
    (define c (context-isolate ctx 'db))
    (check-false (eq? (context-realm a 'db) shared-realm))
    (check-eq? (context-realm b 'db) (context-realm a 'db))
    (check-false (eq? (context-realm c 'db) (context-realm a 'db)))
    (check-eq? (context-realm ctx 'db) shared-realm)
    ;; another name is not affected
    (check-eq? (context-realm a 'other) (context-realm ctx 'other))
    (ctx-provide a 'db 'in-a)
    (check-equal? (ctx-get ctx 'db) 'shared)
    (check-equal? (ctx-get a 'db) 'in-a)
    (check-equal? (ctx-get b 'db) 'in-a)
    (check-false (ctx-get c 'db))
    (define realm (make-realm 'db))
    (check-true (symbol? realm))
    (check-false (symbol-interned? realm))
    (check-false (eq? realm (make-realm 'db)))
    (check-equal? (symbol->string realm) "db")))

(test-case "current-context: set for plugin bodies, listeners and inverses; call-with-context"
  (define-values (note notes) (make-recorder))
  (with-root-context (ctx)
    (check-false (current-context))
    (define plugin-ctx #f)
    (ctx-on ctx 'probe (lambda () (note (eq? (current-context) ctx))))
    (define f
      (ctx-plugin ctx (lambda (c config)
                        (set! plugin-ctx c)
                        (note (eq? (current-context) c))
                        (ctx-emit c 'probe)
                        (note (eq? (current-context) c))
                        (lambda () (note (eq? (current-context) c))))))
    (await/t f)
    (fiber-dispose! f)
    (check-eq? (call-with-context plugin-ctx current-context) plugin-ctx)
    (check-false (current-context)))
  (check-equal? (notes) '(#t #t #t #t)))

(test-case "dispose!: unloads everything registered through the root; the root stays usable"
  (define-values (note notes) (make-recorder))
  (with-root-context (ctx)
    (define before (kernel-snapshot ctx))
    (ctx-provide ctx 'db 1)
    (ctx-on ctx 'event void)
    (ctx-accessor ctx 'shortcut #:get (lambda (c) 1))
    (ctx-effect ctx (lambda () (lambda () (note 'root-effect))))
    (define f (ctx-plugin ctx (lambda (c config)
                                (ctx-plugin c (lambda (cc config) (lambda () (note 'grandchild))))
                                (lambda () (note 'child)))))
    (await/t f)
    (check-equal? (context-dispose! ctx) (void))
    (check-equal? (kernel-snapshot ctx) before)
    (check-eq? (fiber-state (context-fiber ctx)) 'active)
    (check-equal? (fiber-uid (context-fiber ctx)) 0)
    (check-eq? (fiber-state f) 'disposed)
    (check-equal? (fiber-effects (context-fiber ctx)) '())
    ;; kernel listeners survive: a fiber-local update listener still registers
    (define g (ctx-plugin ctx (lambda (c config) (void))))
    (await/t g)
    (check-equal? (disposer-label (ctx-on (fiber-context g) 'internal/update void))
                  "ctx.on(\"internal/update\")")
    (check-eq? (fiber-state g) 'active))
  (check-equal? (sort (map symbol->string (notes)) string<?)
                '("child" "grandchild" "root-effect")))

(test-case "shutdown!: disposes, then ends the kernel; idempotent; later operations raise"
  (define-values (note notes) (make-recorder))
  (define root (make-root-context))
  (define f (ctx-plugin root (lambda (c config) (lambda () (note 'unloaded)))))
  (sync/t f)
  (check-equal? (context-shutdown! root) (void))
  (check-equal? (notes) '(unloaded))
  (check-eq? (fiber-state f) 'disposed)
  (check-equal? (context-shutdown! root) (void))
  (check-exn exn:fail:cordis? (lambda () (ctx-provide root 'db 1)))
  (check-exn exn:fail:cordis? (lambda () (ctx-emit root 'event)))
  (check-exn exn:fail:cordis? (lambda () (spawn-task void #:scheduler (context-scheduler root))))
  ;; read-only accessors still work
  (check-false (ctx-get root 'db))
  (check-equal? (fiber-name (context-fiber root)) "root"))

(test-case "keys: strings are accepted wherever a key is"
  (with-root-context (ctx)
    (ctx-provide ctx "db" 1)
    (check-equal? (ctx-get ctx 'db) 1)
    (check-true (ctx-has? ctx "db"))
    (define-values (note notes) (make-recorder))
    (ctx-on ctx "event" note)
    (ctx-emit ctx 'event 1)
    (ctx-emit ctx "event" 2)
    (check-equal? (notes) '(1 2))
    (check-equal? (length (ctx-listeners ctx "event")) 1)))

;; ---------------------------------------------------------------------------------------
;; Loader support

(test-case "loader: a rebindable context reads parent, realms and intercepts through its cell"
  (with-root-context (ctx)
    (ctx-provide ctx 'db 'shared)
    (define group-a (context-extend (context-isolate ctx 'db) (hasheq 'group 'a)))
    (define group-b (context-extend (context-isolate ctx 'db) (hasheq 'group 'b)))
    (ctx-provide group-a 'db 'in-a)
    (ctx-provide group-b 'db 'in-b)
    (define entry (context-derive/rebindable group-a))
    (define below (context-extend entry (hasheq 'depth 1)))
    (check-eq? (context-parent entry) group-a)
    (check-equal? (context-own-realms entry) (hasheq))
    (check-equal? (context-own-intercepts entry) (hasheq))
    (check-equal? (ctx-get below 'db) 'in-a)
    (check-equal? (context-meta below 'group) 'a)
    (check-equal? (context-meta below 'depth) 1)
    ;; re-parent: every context derived from the entry follows
    (context-rebind! entry #:parent group-b)
    (check-eq? (context-parent entry) group-b)
    (check-equal? (ctx-get below 'db) 'in-b)
    (check-equal? (context-meta below 'group) 'b)
    ;; change isolation and interception in place
    (define private (make-realm 'db))
    (context-rebind! entry #:realms (hasheq 'db private) #:intercepts (hash "db" 'layer))
    (check-eq? (context-realm below 'db) private)
    (check-false (ctx-get below 'db))
    (check-equal? (context-own-realms entry) (hasheq 'db private))
    (check-equal? (context-intercepts below 'db) '(layer))
    (context-rebind! entry #:realms (hasheq))
    (check-equal? (ctx-get below 'db) 'in-b)
    (check-exn exn:fail:contract? (lambda () (context-rebind! below #:parent ctx)))
    (check-exn exn:fail:contract? (lambda () (context-own-realms ctx)))))

(test-case "loader: a fiber mounted below a rebindable context follows a rebind after notify"
  (define-values (note notes) (make-recorder))
  (with-root-context (ctx)
    (define group-a (context-isolate ctx 'db))
    (define group-b (context-isolate ctx 'db))
    (ctx-provide group-a 'db 'in-a)
    (ctx-provide group-b 'db 'in-b)
    (define entry (context-derive/rebindable group-a))
    (define f (ctx-plugin entry (make-plugin (lambda (c config) (note (ctx-ref c 'db)) (void))
                                             #:inject '(db))))
    (await/t f)
    (context-rebind! entry #:parent group-b)
    ;; nothing happens until the loader notifies
    (check-eq? (fiber-state f) 'active)
    (fiber-recheck! f)
    (await/t f)
    (check-eq? (fiber-state f) 'active)
    (check-equal? (hash-ref (fiber-committed f) 'db) 'in-b)
    ;; an explicit notification with a custom filter reaches the same fiber
    (context-rebind! entry #:parent group-a)
    (ctx-notify! ctx '(db) #:filter (lambda (c key) (eq? c (fiber-context f))))
    (await/t f)
    (check-equal? (hash-ref (fiber-committed f) 'db) 'in-a))
  (check-equal? (notes) '(in-a in-b in-a)))

(test-case "loader: inject additions, attached data, raw config, moving a service"
  (with-root-context (ctx)
    (define f (ctx-plugin ctx (make-plugin (lambda (c config) (void)) #:inject '(first))
                          'initial))
    (ctx-provide ctx 'first 1)
    (await/t f)
    (check-eq? (fiber-state f) 'active)
    (fiber-add-inject! f 'second (hasheq 'option 1))
    (check-equal? (hash-ref (fiber-inject f) 'second) (hasheq 'option 1))
    (fiber-recheck! f)
    (await/t f)
    (check-eq? (fiber-state f) 'pending)
    (ctx-provide ctx 'second 2)
    (await/t f)
    (check-eq? (fiber-state f) 'active)
    (check-equal? (fiber-committed f) (hasheq 'first 1 'second 2))
    (fiber-prop-set! f 'entry 'the-entry)
    (check-equal? (fiber-prop-ref f 'entry) 'the-entry)
    (check-equal? (fiber-prop-ref f 'missing 'default) 'default)
    (fiber-set-raw-config! f 'retained)
    (check-equal? (fiber-config f) 'retained)
    (check-equal? (fiber-effective-config f) 'initial)
    (check-equal? (fiber-resolve-config f 'candidate) 'candidate)
    (define elsewhere (make-realm 'first))
    (check-true (service-move! ctx (context-realm ctx 'first) elsewhere))
    (check-false (ctx-has? ctx 'first))
    (check-equal? (ctx-get (context-isolate ctx 'first elsewhere) 'first) 1)
    (check-false (service-move! ctx (context-realm ctx 'first) elsewhere))
    (define other-parent (context-extend ctx (hasheq 'x 1)))
    (fiber-reparent! f other-parent)
    (check-eq? (fiber-parent f) other-parent)))
