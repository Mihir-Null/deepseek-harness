   (describe (ok "[]" "[]" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022tuple\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022list\u0022:[]}}}"))
