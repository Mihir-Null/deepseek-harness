    ((input (("a" . 1))) (options ) (result (error "$.a expected string but got 1" #("a"))))
    ((input (("a" . 1) ("b" . "q"))) (options (autofix . #t)) (result (ok (("x-b" . "q")) (("x-b" . "q")) (ok (("x-b" . "q"))))))))
  ((name "dict key const")
   (spec (dict (boolean) (union ((from "on") (from "off")))))
   (describe (ok "{ [key: \u0022on\u0022 | \u0022off\u0022]: boolean }" "{ [key: \u0022on\u0022 | \u0022off\u0022]: boolean }" "{\u0022uid\u0022:4,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022boolean\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022const\u0022,\u0022meta\u0022:{\u0022required\u0022:true},\u0022value\u0022:\u0022on\u0022},\u00222\u0022:{\u0022type\u0022:\u0022const\u0022,\u0022meta\u0022:{\u0022required\u0022:true},\u0022value\u0022:\u0022off\u0022},\u00223\u0022:{\u0022type\u0022:\u0022union\u0022,\u0022meta\u0022:{},\u0022list\u0022:[1,2]},\u00224\u0022:{\u0022type\u0022:\u0022dict\u0022,\u0022meta\u0022:{\u0022default\u0022:{}},\u0022inner\u0022:0,\u0022sKey\u0022:3}}}"))
   (cases
    ((input (("on" . #t))) (options ) (result (ok (("on" . #t)) (("on" . #t)) (ok (("on" . #t))))))
    ((input (("on" . #t) ("other" . #f))) (options ) (result (error "expected \u0022on\u0022 | \u0022off\u0022 but got \u0022other\u0022" #())))
    ((input (("on" . #t) ("other" . #f))) (options (strict . #t)) (result (ok (("on" . #t)) (("on" . #t) ("other" . #f)) (ok (("on" . #t))))))))
  ((name "dict autofix")
   (spec (dict (number)))
   (describe (ok "{ [key: string]: number }" "{ [key: string]: number }" "{\u0022uid\u0022:2,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00222\u0022:{\u0022type\u0022:\u0022dict\u0022,\u0022meta\u0022:{\u0022default\u0022:{}},\u0022inner\u0022:0,\u0022sKey\u0022:1}}}"))
   (cases
