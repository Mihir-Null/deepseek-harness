  ((name "is Number")
   (spec (is "Number"))
   (describe (ok "Number" "Number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022is\u0022,\u0022meta\u0022:{},\u0022constructor\u0022:\u0022Number\u0022}}}"))
   (cases
