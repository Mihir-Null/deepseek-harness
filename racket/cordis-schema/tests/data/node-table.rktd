    ((input "x") (options ) (result (error "expected Number but got x" #())))))
  ((name "is Boolean")
   (spec (is "Boolean"))
   (describe (ok "Boolean" "Boolean" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022is\u0022,\u0022meta\u0022:{},\u0022constructor\u0022:\u0022Boolean\u0022}}}"))
   (cases
