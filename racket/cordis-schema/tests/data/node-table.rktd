  ((name "is Foo")
   (spec (is "Foo"))
   (describe (ok "Foo" "Foo" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022is\u0022,\u0022meta\u0022:{},\u0022constructor\u0022:\u0022Foo\u0022}}}"))
   (cases
    ((input ()) (options ) (result (error "expected Foo but got [object Object]" #())))
    ((input "x") (options ) (result (error "expected Foo but got x" #())))
    ((input undefined) (options ) (result (ok undefined undefined (ok null))))))
  ((name "bitset")
   (spec (bitset (("read" . 1) ("write" . 2) ("exec" . 4) ("admin" . 8))))
   (describe (ok "bitset" "bitset" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022bitset\u0022,\u0022meta\u0022:{\u0022default\u0022:0},\u0022bits\u0022:{\u0022read\u0022:1,\u0022write\u0022:2,\u0022exec\u0022:4,\u0022admin\u0022:8}}}}"))
   (cases
    ((input undefined) (options ) (result (ok 0 undefined (ok null))))
    ((input null) (options ) (result (ok 0 null (ok null))))
    ((input 0) (options ) (result (ok 0 0 (ok null))))
    ((input 3) (options ) (result (ok 3 #("read" "write") (ok 3))))
    ((input 5) (options ) (result (ok 5 #("read" "exec") (ok 5))))
    ((input 15) (options ) (result (ok 15 #("read" "write" "exec" "admin") (ok 15))))
    ((input 16) (options ) (result (ok 16 #() (ok 16))))
    ((input -1) (options ) (result (ok -1 #("read" "write" "exec" "admin") (ok -1))))
    ((input 4294967297) (options ) (result (ok 4294967297 #("read") (ok 4294967297))))
    ((input 1.5) (options ) (result (ok 1.5 #("read") (ok 1.5))))
    ((input #()) (options ) (result (ok 0 #() (ok null))))
    ((input #("read")) (options ) (result (ok 1 #("read") (ok 1))))
    ((input #("read" "exec")) (options ) (result (ok 5 #("read" "exec") (ok 5))))
    ((input #("exec" "read" "read")) (options ) (result (ok 5 #("exec" "read" "read") (ok 5))))
    ((input #("nope")) (options ) (result (ok 0 #("nope") (ok null))))
    ((input #("toString")) (options ) (result (ok 0 #("toString") (ok null))))
    ((input #("read" 1)) (options ) (result (error "expected string but got 1" #())))
    ((input "read") (options ) (result (error "expected number or array but got read" #())))
    ((input ()) (options ) (result (error "expected number or array but got [object Object]" #())))
    ((input #t) (options ) (result (error "expected number or array but got true" #())))))
  ((name "bitset default number")
   (spec (with (bitset (("read" . 1) ("write" . 2) ("exec" . 4) ("admin" . 8))) ((default 3))))
   (describe (ok "bitset" "bitset" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022bitset\u0022,\u0022meta\u0022:{\u0022default\u0022:3},\u0022bits\u0022:{\u0022read\u0022:1,\u0022write\u0022:2,\u0022exec\u0022:4,\u0022admin\u0022:8}}}}"))
   (cases
    ((input undefined) (options ) (result (ok 3 undefined (ok null))))
    ((input 3) (options ) (result (ok 3 3 (ok null))))
    ((input #("read" "write")) (options ) (result (ok 3 #("read" "write") (ok null))))
    ((input #("read")) (options ) (result (ok 1 #("read") (ok 1))))))
  ((name "bitset default keys")
   (spec (with (bitset (("read" . 1) ("write" . 2) ("exec" . 4) ("admin" . 8))) ((default #("read")))))
   (describe (ok "bitset" "bitset" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022bitset\u0022,\u0022meta\u0022:{\u0022default\u0022:[\u0022read\u0022]},\u0022bits\u0022:{\u0022read\u0022:1,\u0022write\u0022:2,\u0022exec\u0022:4,\u0022admin\u0022:8}}}}"))
   (cases
    ((input undefined) (options ) (result (ok 1 #("read") (ok 1))))
    ((input null) (options ) (result (ok 1 #("read") (ok 1))))
    ((input 1) (options ) (result (ok 1 #("read") (ok 1))))
    ((input #("read")) (options ) (result (ok 1 #("read") (ok 1))))))
  ((name "bitset mixed bits")
   (spec (bitset (("a" . 1) ("b" . "x") ("c" . 2147483648) ("d" . 3))))
   (describe (ok "bitset" "bitset" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022bitset\u0022,\u0022meta\u0022:{\u0022default\u0022:0},\u0022bits\u0022:{\u0022a\u0022:1,\u0022c\u0022:2147483648,\u0022d\u0022:3}}}}"))
   (cases
    ((input 3) (options ) (result (ok 3 #("a" "d") (ok 3))))
    ((input #("a" "c")) (options ) (result (ok -2147483647 #("a" "c") (ok -2147483647))))
    ((input #("b")) (options ) (result (ok 0 #("b") (ok null))))
    ((input 2147483648) (options ) (result (ok 2147483648 #("c") (ok 2147483648))))
    ((input #("d")) (options ) (result (ok 3 #("d") (ok 3))))))
  ((name "array")
   (spec (array (string)))
   (describe (ok "string[]" "string[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022inner\u0022:0}}}"))
   (cases
    ((input undefined) (options ) (result (ok #() undefined (ok null))))
    ((input null) (options ) (result (ok #() null (ok null))))
    ((input #()) (options ) (result (ok #() #() (ok null))))
    ((input #("a")) (options ) (result (ok #("a") #("a") (ok #("a")))))
    ((input #("a" 1)) (options ) (result (error "$[1] expected string but got 1" #(1))))
    ((input #("a" null)) (options ) (result (ok #("a" null) #("a" null) (ok #("a" null)))))
    ((input #("a" undefined "b")) (options ) (result (ok #("a" undefined "b") #("a" undefined "b") (ok #("a" null "b")))))
    ((input "a") (options ) (result (error "expected array but got a" #())))
    ((input ()) (options ) (result (error "expected array but got [object Object]" #())))
    ((input 5) (options ) (result (error "expected array but got 5" #())))))
  ((name "array of String")
   (spec (array (prim "String")))
   (describe (ok "string[]" "string[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{\u0022required\u0022:true}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022inner\u0022:0}}}"))
   (cases
    ((input #()) (options ) (result (ok #() #() (ok null))))
    ((input #("a")) (options ) (result (ok #("a") #("a") (ok #("a")))))
    ((input #(null)) (options ) (result (error "$[0] missing required value" #(0))))
    ((input #("a" undefined)) (options ) (result (error "$[1] missing required value" #(1))))))
  ((name "array of default")
   (spec (array (with (number) ((default 7)))))
   (describe (ok "number[]" "number[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022default\u0022:7}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022inner\u0022:0}}}"))
   (cases
    ((input #(1 null 3)) (options ) (result (ok #(1 7 3) #(1 null 3) (ok #(1 null 3)))))
    ((input #(undefined)) (options ) (result (ok #(7) #(undefined) (ok #(null)))))))
  ((name "array bounds")
   (spec (with (array (number)) ((min 2) (max 3))))
   (describe (ok "number[]" "number[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[],\u0022min\u0022:2,\u0022max\u0022:3},\u0022inner\u0022:0}}}"))
   (cases
    ((input #()) (options ) (result (error "expected array length >= 2 but got 0" #())))
    ((input #(1)) (options ) (result (error "expected array length >= 2 but got 1" #())))
    ((input #(1 2)) (options ) (result (ok #(1 2) #(1 2) (ok #(1 2)))))
    ((input #(1 2 3)) (options ) (result (ok #(1 2 3) #(1 2 3) (ok #(1 2 3)))))
    ((input #(1 2 3 4)) (options ) (result (error "expected array length <= 3 but got 4" #())))))
  ((name "array min with inner default")
   (spec (with (array (with (number) ((default 1)))) ((min 2) (max 3))))
   (describe (ok "number[]" "number[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022default\u0022:1}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[],\u0022min\u0022:2,\u0022max\u0022:3},\u0022inner\u0022:0}}}"))
   (cases
    ((input #()) (options ) (result (ok #() #() (ok null))))
    ((input #(1)) (options ) (result (ok #(1) #(1) (ok #(null)))))
    ((input #(1 2 3 4)) (options ) (result (error "expected array length <= 3 but got 4" #())))))
  ((name "array default")
   (spec (with (array (string)) ((default #(".")) (role "table"))))
   (describe (ok "string[]" "string[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[\u0022.\u0022],\u0022role\u0022:\u0022table\u0022},\u0022inner\u0022:0}}}"))
   (cases
    ((input undefined) (options ) (result (ok #(".") undefined (ok null))))
    ((input null) (options ) (result (ok #(".") null (ok null))))
    ((input #()) (options ) (result (ok #() #() (ok #()))))
    ((input #("a")) (options ) (result (ok #("a") #("a") (ok #("a")))))))
  ((name "array required")
   (spec (with (array (string)) ((required))))
   (describe (ok "string[]" "string[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[],\u0022required\u0022:true},\u0022inner\u0022:0}}}"))
   (cases
    ((input undefined) (options ) (result (error "missing required value" #())))
    ((input #()) (options ) (result (ok #() #() (ok null))))))
  ((name "array undefined default")
   (spec (with (array (string)) ((default undefined))))
   (describe (ok "string[]" "string[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{},\u0022inner\u0022:0}}}"))
   (cases
    ((input undefined) (options ) (result (ok undefined undefined (ok null))))
    ((input null) (options ) (result (ok null null (ok null))))
    ((input #("a")) (options ) (result (ok #("a") #("a") (ok #("a")))))))
  ((name "array autofix")
   (spec (array (number)))
   (describe (ok "number[]" "number[]" "{\u0022uid\u0022:1,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022inner\u0022:0}}}"))
   (cases
    ((input #(1 "x" 3)) (options (autofix . #t)) (result (ok #(1 undefined 3) #(1 undefined 3) (ok #(1 null 3)))))
    ((input #("x")) (options (autofix . #t)) (result (ok #(undefined) #(undefined) (ok #(null)))))
    ((input "x") (options (autofix . #t)) (result (error "expected array but got x" #())))))
  ((name "array of arrays")
   (spec (array (array (number))))
   (describe (ok "number[][]" "number[][]" "{\u0022uid\u0022:2,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022inner\u0022:0},\u00222\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022inner\u0022:1}}}"))
   (cases
    ((input #(#(1) #(2 3))) (options ) (result (ok #(#(1) #(2 3)) #(#(1) #(2 3)) (ok #(#(1) #(2 3))))))
    ((input #(#(1) 2)) (options ) (result (error "$[1] expected array but got 2" #(1))))
    ((input #(#(1 "x"))) (options ) (result (error "$[0][1] expected number but got x" #(0 1))))
    ((input #(#(1 "x") "y")) (options (autofix . #t)) (result (ok #(#(1 undefined) #()) #(#(1 undefined) undefined) (ok #(#(1 null) null)))))))
  ((name "dict")
   (spec (dict (number)))
   (describe (ok "{ [key: string]: number }" "{ [key: string]: number }" "{\u0022uid\u0022:2,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00222\u0022:{\u0022type\u0022:\u0022dict\u0022,\u0022meta\u0022:{\u0022default\u0022:{}},\u0022inner\u0022:0,\u0022sKey\u0022:1}}}"))
   (cases
    ((input undefined) (options ) (result (ok () undefined (ok null))))
    ((input null) (options ) (result (ok () null (ok null))))
    ((input ()) (options ) (result (ok () () (ok null))))
    ((input (("a" . 1))) (options ) (result (ok (("a" . 1)) (("a" . 1)) (ok (("a" . 1))))))
    ((input (("a" . 1) ("b" . "x"))) (options ) (result (error "$.b expected number but got x" #("b"))))
    ((input (("a" . null))) (options ) (result (ok (("a" . null)) (("a" . null)) (ok (("a" . null))))))
    ((input #()) (options ) (result (error "expected object but got " #())))
    ((input "x") (options ) (result (error "expected object but got x" #())))
    ((input 5) (options ) (result (error "expected object but got 5" #())))))
  ((name "dict of String")
   (spec (dict (prim "String")))
   (describe (ok "{ [key: string]: string }" "{ [key: string]: string }" "{\u0022uid\u0022:2,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{\u0022required\u0022:true}},\u00221\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00222\u0022:{\u0022type\u0022:\u0022dict\u0022,\u0022meta\u0022:{\u0022default\u0022:{}},\u0022inner\u0022:0,\u0022sKey\u0022:1}}}"))
   (cases
    ((input (("a" . "x"))) (options ) (result (ok (("a" . "x")) (("a" . "x")) (ok (("a" . "x"))))))
    ((input (("a" . null))) (options ) (result (error "$.a missing required value" #("a"))))
    ((input (("a" . 1))) (options ) (result (error "$.a expected string but got 1" #("a"))))))
  ((name "dict default")
   (spec (with (dict (prim "String")) ((default (("k" . "v"))))))
   (describe (ok "{ [key: string]: string }" "{ [key: string]: string }" "{\u0022uid\u0022:2,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{\u0022required\u0022:true}},\u00221\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00222\u0022:{\u0022type\u0022:\u0022dict\u0022,\u0022meta\u0022:{\u0022default\u0022:{\u0022k\u0022:\u0022v\u0022}},\u0022inner\u0022:0,\u0022sKey\u0022:1}}}"))
   (cases
    ((input undefined) (options ) (result (ok (("k" . "v")) undefined (ok null))))
    ((input null) (options ) (result (ok (("k" . "v")) null (ok null))))
    ((input ()) (options ) (result (ok () () (ok ()))))
    ((input (("a" . "b"))) (options ) (result (ok (("a" . "b")) (("a" . "b")) (ok (("a" . "b"))))))))
  ((name "dict key pattern")
   (spec (dict (number) (with (string) ((pattern "^[a-z]+$")))))
   (describe (ok "{ [key: string]: number }" "{ [key: string]: number }" "{\u0022uid\u0022:2,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{\u0022pattern\u0022:{\u0022source\u0022:\u0022^[a-z]+$\u0022,\u0022flags\u0022:\u0022\u0022}}},\u00222\u0022:{\u0022type\u0022:\u0022dict\u0022,\u0022meta\u0022:{\u0022default\u0022:{}},\u0022inner\u0022:0,\u0022sKey\u0022:1}}}"))
   (cases
