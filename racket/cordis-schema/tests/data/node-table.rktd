   (spec (tuple ((prim "String") (array (prim "Number")))))
   (describe (ok "[string, number[]]" "[string, number[]]" "{\u0022uid\u0022:3,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{\u0022required\u0022:true}},\u00221\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022required\u0022:true}},\u00222\u0022:{\u0022type\u0022:\u0022array\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022inner\u0022:1},\u00223\u0022:{\u0022type\u0022:\u0022tuple\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022list\u0022:[0,2]}}}"))
   (cases
