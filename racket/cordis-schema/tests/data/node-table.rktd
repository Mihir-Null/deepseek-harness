   (spec (dict (number) (transform (string) "upper")))
   (describe (ok "{ [key: string]: number }" "{ [key: string]: number }" "{\u0022uid\u0022:3,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00222\u0022:{\u0022type\u0022:\u0022transform\u0022,\u0022meta\u0022:{},\u0022inner\u0022:1,\u0022callback\u0022:\u0022(v) => v.toUpperCase()\u0022},\u00223\u0022:{\u0022type\u0022:\u0022dict\u0022,\u0022meta\u0022:{\u0022default\u0022:{}},\u0022inner\u0022:0,\u0022sKey\u0022:2}}}"))
   (cases
