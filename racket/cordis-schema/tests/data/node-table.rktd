    ((input (("ab" . 1) ("AB" . 2))) (options ) (result (error "expect string to match regexp /^[a-z]+$/" #())))
    ((input (("ab" . 1) ("AB" . 2))) (options (strict . #t)) (result (ok (("ab" . 1)) (("ab" . 1) ("AB" . 2)) (ok (("ab" . 1))))))))
