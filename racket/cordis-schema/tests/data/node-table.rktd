  ((name "dict of objects")
   (spec (dict (object (("sandbox" . (with (union ((from "read-only") (from "workspace-write"))) ((required)))) ("name" . (string))))))
   (describe (ok "{ [key: string]: { sandbox: \u0022read-only\u0022 | \u0022workspace-write\u0022, name?: string } }" "{ [key: string]: { sandbox: \u0022read-only\u0022 | \u0022workspace-write\u0022, name?: string } }" "{\u0022uid\u0022:6,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022const\u0022,\u0022meta\u0022:{\u0022required\u0022:true},\u0022value\u0022:\u0022read-only\u0022},\u00221\u0022:{\u0022type\u0022:\u0022const\u0022,\u0022meta\u0022:{\u0022required\u0022:true},\u0022value\u0022:\u0022workspace-write\u0022},\u00222\u0022:{\u0022type\u0022:\u0022union\u0022,\u0022meta\u0022:{\u0022required\u0022:true},\u0022list\u0022:[0,1]},\u00223\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00224\u0022:{\u0022type\u0022:\u0022object\u0022,\u0022meta\u0022:{\u0022default\u0022:{}},\u0022dict\u0022:{\u0022sandbox\u0022:2,\u0022name\u0022:3}},\u00225\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00226\u0022:{\u0022type\u0022:\u0022dict\u0022,\u0022meta\u0022:{\u0022default\u0022:{}},\u0022inner\u0022:4,\u0022sKey\u0022:5}}}"))
   (cases
    ((input (("p" . (("sandbox" . "read-only"))))) (options ) (result (ok (("p" . (("sandbox" . "read-only")))) (("p" . (("sandbox" . "read-only")))) (ok (("p" . (("sandbox" . "read-only"))))))))
    ((input (("p" . ()))) (options ) (result (error "$.p.sandbox missing required value" #("p" "sandbox"))))
    ((input (("p" . (("sandbox" . "x"))))) (options ) (result (error "$.p.sandbox expected \u0022read-only\u0022 | \u0022workspace-write\u0022 but got \u0022x\u0022" #("p" "sandbox"))))
    ((input (("p" . (("sandbox" . "read-only") ("extra" . 1))) ("q" . (("sandbox" . "workspace-write") ("name" . "n"))))) (options ) (result (ok (("p" . (("sandbox" . "read-only") ("extra" . 1))) ("q" . (("sandbox" . "workspace-write") ("name" . "n")))) (("p" . (("sandbox" . "read-only") ("extra" . 1))) ("q" . (("sandbox" . "workspace-write") ("name" . "n")))) (ok (("p" . (("sandbox" . "read-only"))) ("q" . (("sandbox" . "workspace-write") ("name" . "n"))))))))))
  ((name "tuple")
   (spec (tuple ((number) (string))))
   (describe (ok "[number, string]" "[number, string]" "{\u0022uid\u0022:2,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{}},\u00221\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{}},\u00222\u0022:{\u0022type\u0022:\u0022tuple\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022list\u0022:[0,1]}}}"))
   (cases
    ((input undefined) (options ) (result (ok #(undefined undefined) undefined (ok #(null null)))))
    ((input #()) (options ) (result (ok #(undefined undefined) #() (ok #(null null)))))
    ((input #(1)) (options ) (result (ok #(1 undefined) #(1) (ok #(1 null)))))
    ((input #(1 "a")) (options ) (result (ok #(1 "a") #(1 "a") (ok #(1 "a")))))
    ((input #(1 "a" #t null)) (options ) (result (ok #(1 "a" #t null) #(1 "a" #t null) (ok #(1 "a" #t null)))))
    ((input #("a")) (options ) (result (error "$[0] expected number but got a" #(0))))
    ((input #(1 2)) (options ) (result (error "$[1] expected string but got 2" #(1))))
    ((input "x") (options ) (result (error "expected array but got x" #())))
    ((input ()) (options ) (result (error "expected array but got [object Object]" #())))
    ((input #(1 "a" #t)) (options (strict . #t)) (result (ok #(1 "a") #(1 "a" #t) (ok #(1 "a")))))
    ((input #("a" 1)) (options (autofix . #t)) (result (ok #(undefined undefined) #(undefined undefined) (ok #(null null)))))))
  ((name "tuple defaults")
   (spec (tuple ((with (number) ((default 1))) (with (string) ((required))))))
   (describe (ok "[number, string]" "[number, string]" "{\u0022uid\u0022:2,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022default\u0022:1}},\u00221\u0022:{\u0022type\u0022:\u0022string\u0022,\u0022meta\u0022:{\u0022required\u0022:true}},\u00222\u0022:{\u0022type\u0022:\u0022tuple\u0022,\u0022meta\u0022:{\u0022default\u0022:[]},\u0022list\u0022:[0,1]}}}"))
   (cases
