   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022min\u0022:0,\u0022max\u0022:10}}}}"))
   (cases
    ((input -1) (options ) (result (error "expected number >= 0 but got -1" #())))
    ((input 0) (options ) (result (ok 0 0 (ok 0))))
    ((input 10) (options ) (result (ok 10 10 (ok 10))))
    ((input 10.5) (options ) (result (error "expected number <= 10 but got 10.5" #())))
    ((input -0.5) (options ) (result (error "expected number >= 0 but got -0.5" #())))
    ((input 5) (options ) (result (ok 5 5 (ok 5))))))
  ((name "number min null")
   (spec (with (number) ((min null))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022min\u0022:null}}}}"))
   (cases
    ((input -1) (options ) (result (error "expected number >= null but got -1" #())))
    ((input 0) (options ) (result (ok 0 0 (ok 0))))
    ((input 1) (options ) (result (ok 1 1 (ok 1))))))
  ((name "number step 1")
   (spec (with (number) ((step 1) (min 1))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:1,\u0022min\u0022:1}}}}"))
   (cases
    ((input 1) (options ) (result (ok 1 1 (ok 1))))
    ((input 2) (options ) (result (ok 2 2 (ok 2))))
    ((input 1.5) (options ) (result (error "expected number multiple of 1 but got 1.5" #())))
    ((input 0) (options ) (result (error "expected number >= 1 but got 0" #())))
    ((input 3) (options ) (result (ok 3 3 (ok 3))))))
  ((name "number step 3 min 1")
   (spec (with (number) ((step 3) (min 1))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:3,\u0022min\u0022:1}}}}"))
   (cases
    ((input 1) (options ) (result (ok 1 1 (ok 1))))
    ((input 4) (options ) (result (ok 4 4 (ok 4))))
    ((input 7) (options ) (result (ok 7 7 (ok 7))))
    ((input 8) (options ) (result (error "expected number multiple of 3 but got 8" #())))
    ((input 2.5) (options ) (result (error "expected number multiple of 3 but got 2.5" #())))))
  ((name "number step 0.1")
   (spec (with (number) ((step 0.1))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:0.1}}}}"))
   (cases
    ((input 0.3) (options ) (result (ok 0.3 0.3 (ok 0.3))))
    ((input 0.7) (options ) (result (ok 0.7 0.7 (ok 0.7))))
    ((input 1.1) (options ) (result (ok 1.1 1.1 (ok 1.1))))
    ((input 0.35) (options ) (result (error "expected number multiple of 0.1 but got 0.35" #())))
    ((input 5) (options ) (result (ok 5 5 (ok 5))))
    ((input 0.30000000000000004) (options ) (result (error "expected number multiple of 0.1 but got 0.30000000000000004" #())))
    ((input 1e-7) (options ) (result (error "expected number multiple of 0.1 but got 1e-7" #())))))
  ((name "number step 0.01")
   (spec (with (number) ((step 0.01))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:0.01}}}}"))
   (cases
    ((input 1.005) (options ) (result (error "expected number multiple of 0.01 but got 1.005" #())))
    ((input 0.29) (options ) (result (ok 0.29 0.29 (ok 0.29))))
    ((input 0.57) (options ) (result (ok 0.57 0.57 (ok 0.57))))
    ((input 1.15) (options ) (result (ok 1.15 1.15 (ok 1.15))))
    ((input 100.01) (options ) (result (ok 100.01 100.01 (ok 100.01))))))
  ((name "number step 0.1 min 0.05")
   (spec (with (number) ((step 0.1) (min 0.05))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:0.1,\u0022min\u0022:0.05}}}}"))
   (cases
    ((input 0.35) (options ) (result (ok 0.35 0.35 (ok 0.35))))
    ((input 0.3) (options ) (result (error "expected number multiple of 0.1 but got 0.3" #())))
    ((input 0.05) (options ) (result (ok 0.05 0.05 (ok 0.05))))
    ((input 0.15) (options ) (result (ok 0.15 0.15 (ok 0.15))))))
  ((name "number step negative")
   (spec (with (number) ((step -2))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:-2}}}}"))
   (cases
    ((input 4) (options ) (result (ok 4 4 (ok 4))))
    ((input 3) (options ) (result (error "expected number multiple of -2 but got 3" #())))
    ((input -6) (options ) (result (ok -6 -6 (ok -6))))))
  ((name "number step 0")
   (spec (with (number) ((step 0))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:0}}}}"))
   (cases
    ((input 4) (options ) (result (ok 4 4 (ok 4))))
    ((input 3.3) (options ) (result (ok 3.3 3.3 (ok 3.3))))))
  ((name "number step 1e-7")
   (spec (with (number) ((step 1e-7))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:1e-7}}}}"))
   (cases
    ((input 3e-7) (options ) (result (ok 3e-7 3e-7 (ok 3e-7))))
    ((input 2.5e-7) (options ) (result (error "expected number multiple of 1e-7 but got 2.5e-7" #())))
    ((input 1) (options ) (result (error "expected number multiple of 1e-7 but got 1" #())))))
  ((name "number step 2.5")
   (spec (with (number) ((step 2.5) (min -5))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:2.5,\u0022min\u0022:-5}}}}"))
   (cases
    ((input 0) (options ) (result (ok 0 0 (ok 0))))
    ((input 2.5) (options ) (result (ok 2.5 2.5 (ok 2.5))))
    ((input 3) (options ) (result (error "expected number multiple of 2.5 but got 3" #())))
    ((input -2.5) (options ) (result (ok -2.5 -2.5 (ok -2.5))))
    ((input 1e+21) (options ) (result (ok 1e+21 1e+21 (ok 1e+21))))))
  ((name "number default")
   (spec (with (number) ((default 3))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022default\u0022:3}}}}"))
   (cases
    ((input undefined) (options ) (result (ok 3 undefined (ok null))))
    ((input null) (options ) (result (ok 3 null (ok null))))
    ((input 0) (options ) (result (ok 0 0 (ok 0))))
    ((input "x") (options ) (result (error "expected number but got x" #())))))
  ((name "natural")
   (spec (natural))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:1,\u0022min\u0022:0}}}}"))
   (cases
    ((input 0) (options ) (result (ok 0 0 (ok 0))))
    ((input 1) (options ) (result (ok 1 1 (ok 1))))
    ((input 2.5) (options ) (result (error "expected number multiple of 1 but got 2.5" #())))
    ((input -1) (options ) (result (error "expected number >= 0 but got -1" #())))
    ((input 1e+21) (options ) (result (ok 1e+21 1e+21 (ok 1e+21))))
    ((input "x") (options ) (result (error "expected number but got x" #())))
    ((input undefined) (options ) (result (ok undefined undefined (ok null))))))
  ((name "natural bounded")
   (spec (with (natural) ((min 1) (max 9007199254740991) (default 50000))))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:1,\u0022min\u0022:1,\u0022max\u0022:9007199254740991,\u0022default\u0022:50000}}}}"))
   (cases
    ((input undefined) (options ) (result (ok 50000 undefined (ok null))))
    ((input 0) (options ) (result (error "expected number >= 1 but got 0" #())))
    ((input 1) (options ) (result (ok 1 1 (ok 1))))
    ((input 9007199254740991) (options ) (result (ok 9007199254740991 9007199254740991 (ok 9007199254740991))))
    ((input 9007199254740992.0) (options ) (result (error "expected number <= 9007199254740991 but got 9007199254740992" #())))
    ((input 1.5) (options ) (result (error "expected number multiple of 1 but got 1.5" #())))))
  ((name "percent")
   (spec (percent))
   (describe (ok "number" "number" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022number\u0022,\u0022meta\u0022:{\u0022step\u0022:0.01,\u0022min\u0022:0,\u0022max\u0022:1,\u0022role\u0022:\u0022slider\u0022}}}}"))
   (cases
    ((input 0) (options ) (result (ok 0 0 (ok 0))))
    ((input 0.5) (options ) (result (ok 0.5 0.5 (ok 0.5))))
    ((input 1) (options ) (result (ok 1 1 (ok 1))))
    ((input 1.01) (options ) (result (error "expected number <= 1 but got 1.01" #())))
    ((input -0.01) (options ) (result (error "expected number >= 0 but got -0.01" #())))
    ((input 0.123) (options ) (result (error "expected number multiple of 0.01 but got 0.123" #())))
    ((input 0.07) (options ) (result (ok 0.07 0.07 (ok 0.07))))
    ((input 0.57) (options ) (result (ok 0.57 0.57 (ok 0.57))))))
  ((name "boolean")
   (spec (boolean))
   (describe (ok "boolean" "boolean" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022boolean\u0022,\u0022meta\u0022:{}}}}"))
   (cases
    ((input undefined) (options ) (result (ok undefined undefined (ok null))))
    ((input null) (options ) (result (ok null null (ok null))))
    ((input #t) (options ) (result (ok #t #t (ok #t))))
    ((input #f) (options ) (result (ok #f #f (ok #f))))
    ((input 0) (options ) (result (error "expected boolean but got 0" #())))
    ((input 1) (options ) (result (error "expected boolean but got 1" #())))
    ((input -1) (options ) (result (error "expected boolean but got -1" #())))
    ((input 1.5) (options ) (result (error "expected boolean but got 1.5" #())))
    ((input "x") (options ) (result (error "expected boolean but got x" #())))
    ((input "") (options ) (result (error "expected boolean but got " #())))
    ((input #()) (options ) (result (error "expected boolean but got " #())))
    ((input ()) (options ) (result (error "expected boolean but got [object Object]" #())))))
  ((name "boolean default")
   (spec (with (boolean) ((default #t))))
   (describe (ok "boolean" "boolean" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022boolean\u0022,\u0022meta\u0022:{\u0022default\u0022:true}}}}"))
   (cases
    ((input undefined) (options ) (result (ok #t undefined (ok null))))
    ((input null) (options ) (result (ok #t null (ok null))))
    ((input #f) (options ) (result (ok #f #f (ok #f))))))
  ((name "boolean required")
   (spec (with (boolean) ((required))))
   (describe (ok "boolean" "boolean" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022boolean\u0022,\u0022meta\u0022:{\u0022required\u0022:true}}}}"))
   (cases
    ((input undefined) (options ) (result (error "missing required value" #())))
    ((input #f) (options ) (result (ok #f #f (ok #f))))))
  ((name "function")
   (spec (function))
   (describe (ok "function" "function" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022function\u0022,\u0022meta\u0022:{}}}}"))
   (cases
    ((input undefined) (options ) (result (ok undefined undefined (ok null))))
    ((input 1) (options ) (result (error "expected function but got 1" #())))
    ((input "x") (options ) (result (error "expected function but got x" #())))
    ((input ()) (options ) (result (error "expected function but got [object Object]" #())))))
  ((name "is Array")
   (spec (is "Array"))
   (describe (ok "Array" "Array" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022is\u0022,\u0022meta\u0022:{},\u0022constructor\u0022:\u0022Array\u0022}}}"))
   (cases
    ((input #()) (options ) (result (ok #() #() (ok #()))))
    ((input #(1)) (options ) (result (ok #(1) #(1) (ok #(1)))))
    ((input ()) (options ) (result (error "expected Array but got [object Object]" #())))
    ((input "x") (options ) (result (error "expected Array but got x" #())))
    ((input 1) (options ) (result (error "expected Array but got 1" #())))
    ((input undefined) (options ) (result (ok undefined undefined (ok null))))))
  ((name "is Object")
   (spec (is "Object"))
   (describe (ok "Object" "Object" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022is\u0022,\u0022meta\u0022:{},\u0022constructor\u0022:\u0022Object\u0022}}}"))
   (cases
    ((input ()) (options ) (result (ok () () (ok ()))))
    ((input #()) (options ) (result (ok #() #() (ok #()))))
    ((input "x") (options ) (result (ok "x" "x" (ok "x"))))
    ((input 1) (options ) (result (ok 1 1 (ok 1))))
    ((input #t) (options ) (result (ok #t #t (ok #t))))
    ((input undefined) (options ) (result (ok undefined undefined (ok null))))
    ((input null) (options ) (result (ok null null (ok null))))))
  ((name "is String")
   (spec (is "String"))
   (describe (ok "String" "String" "{\u0022uid\u0022:0,\u0022refs\u0022:{\u00220\u0022:{\u0022type\u0022:\u0022is\u0022,\u0022meta\u0022:{},\u0022constructor\u0022:\u0022String\u0022}}}"))
   (cases
    ((input "x") (options ) (result (ok "x" "x" (ok "x"))))
