#lang racket/base
;; Tests for section 4 of docs/racket/contracts/cordis-data.md: the UTF-16, UTF-8 and code-point
;; length helpers on strings with astral characters, JavaScript's string ordering, and
;; `js-number->string`. The expected values were checked against Node; node-table-test.rkt
;; repeats the comparison on generated strings.

(require rackunit
         cordis-data)

;; A string of the given code points; keeps this file ASCII.
(define (chars . codes)
  (apply string (map integer->char codes)))

;; U+1F600 and U+10000 need two UTF-16 units and four UTF-8 bytes each.
(define face (chars #x1F600))
(define linear-b (chars #x10000))
;; U+00E9 is one unit and two bytes; U+4E2D is one unit and three bytes.
(define e-acute (chars #xE9))
(define zhong (chars #x4E2D))
(define mixed (string-append "a" face "b" e-acute zhong linear-b))

(test-case "the three length units"
  (check-equal? (utf16-length "") 0)
  (check-equal? (utf8-length "") 0)
  (check-equal? (code-point-length "") 0)
  (check-equal? (list (utf16-length "hello") (utf8-length "hello") (code-point-length "hello"))
                '(5 5 5))
  (check-equal? (list (utf16-length face) (utf8-length face) (code-point-length face)) '(2 4 1))
  (check-equal? (list (utf16-length e-acute) (utf8-length e-acute) (code-point-length e-acute))
                '(1 2 1))
  (check-equal? (list (utf16-length zhong) (utf8-length zhong) (code-point-length zhong)) '(1 3 1))
  (check-equal? (list (utf16-length mixed) (utf8-length mixed) (code-point-length mixed))
                '(8 15 6))
  (check-equal? (utf16-length (chars #xFFFF #x10000 #x10FFFF)) 5)
  (check-exn exn:fail:contract? (lambda () (utf16-length 'a)))
  (check-exn exn:fail:contract? (lambda () (utf8-length #"a")))
  (check-exn exn:fail:contract? (lambda () (code-point-length 5))))

(test-case "utf16-substring slices by UTF-16 unit"
  (check-equal? (utf16-substring "hello" 1 3) "el")
  (check-equal? (utf16-substring "hello" 2) "llo")
  (check-equal? (utf16-substring "hello" 0 5) "hello")
  (check-equal? (utf16-substring "hello" 0 99) "hello")
  (check-equal? (utf16-substring "hello" 5) "")
  (check-equal? (utf16-substring "hello" 99) "")
  (check-equal? (utf16-substring "hello" 3 1) "")
  (check-equal? (utf16-substring "hello" 2 2) "")
  (check-equal? (utf16-substring "hello" 1 #f) "ello")
  ;; mixed is a(0) face(1,2) b(3) e-acute(4) zhong(5) linear-b(6,7).
  (check-equal? (utf16-substring mixed 0 3) (string-append "a" face))
  (check-equal? (utf16-substring mixed 1 3) face)
  (check-equal? (utf16-substring mixed 3 6) (string-append "b" e-acute zhong))
  (check-equal? (utf16-substring mixed 6) linear-b)
  (check-equal? (utf16-substring mixed 0 8) mixed)
  (check-exn exn:fail:contract? (lambda () (utf16-substring "hello" -1)))
  (check-exn exn:fail:contract? (lambda () (utf16-substring "hello" 0 1.5))))

(test-case "a cut inside a surrogate pair drops the half pair"
  (check-equal? (utf16-substring mixed 0 2) "a")
  (check-equal? (utf16-substring mixed 2) (string-append "b" e-acute zhong linear-b))
  (check-equal? (utf16-substring mixed 2 4) "b")
  (check-equal? (utf16-substring mixed 1 2) "")
  (check-equal? (utf16-substring mixed 2 3) "")
  (check-equal? (utf16-substring mixed 5 7) zhong)
  (check-equal? (utf16-substring mixed 7) "")
  (check-equal? (utf16-substring face 1) "")
  (check-equal? (utf16-substring face 0 1) ""))

(test-case "utf16-truncate keeps the longest prefix that fits without splitting a pair"
  (check-equal? (utf16-truncate "hello" 0) "")
  (check-equal? (utf16-truncate "hello" 3) "hel")
  (check-equal? (utf16-truncate "hello" 5) "hello")
  (check-equal? (utf16-truncate "hello" 500) "hello")
  (check-equal? (utf16-truncate mixed 1) "a")
  (check-equal? (utf16-truncate mixed 2) "a")
  (check-equal? (utf16-truncate mixed 3) (string-append "a" face))
  (check-equal? (utf16-truncate mixed 7) (string-append "a" face "b" e-acute zhong))
  (check-equal? (utf16-truncate mixed 8) mixed)
  (check-equal? (utf16-truncate (string-append face face) 3) face)
  (for ([limit (in-range 0 12)])
    (define prefix (utf16-truncate mixed limit))
    (check-true (<= (utf16-length prefix) limit))
    (check-equal? prefix (utf16-substring mixed 0 limit))))

(test-case "utf8-truncate keeps the longest prefix that fits without splitting a character"
  (check-equal? (utf8-truncate "hello" 0) "")
  (check-equal? (utf8-truncate "hello" 3) "hel")
  (check-equal? (utf8-truncate "hello" 5) "hello")
  (check-equal? (utf8-truncate "hello" 500) "hello")
  ;; mixed in bytes: a(1) face(4) b(1) e-acute(2) zhong(3) linear-b(4).
  (check-equal? (utf8-truncate mixed 1) "a")
  (check-equal? (utf8-truncate mixed 4) "a")
  (check-equal? (utf8-truncate mixed 5) (string-append "a" face))
  (check-equal? (utf8-truncate mixed 7) (string-append "a" face "b"))
  (check-equal? (utf8-truncate mixed 8) (string-append "a" face "b" e-acute))
  (check-equal? (utf8-truncate mixed 10) (string-append "a" face "b" e-acute))
  (check-equal? (utf8-truncate mixed 11) (string-append "a" face "b" e-acute zhong))
  (check-equal? (utf8-truncate mixed 14) (string-append "a" face "b" e-acute zhong))
  (check-equal? (utf8-truncate mixed 15) mixed)
  (for ([limit (in-range 0 20)])
    (define prefix (utf8-truncate mixed limit))
    (check-true (<= (utf8-length prefix) limit))
    (check-true (or (equal? prefix mixed)
                    (> (utf8-length (substring mixed 0 (add1 (string-length prefix)))) limit))))
  (check-exn exn:fail:contract? (lambda () (utf8-truncate "hello" -1))))

(test-case "js-string<? orders by UTF-16 code unit"
  (check-true (js-string<? "a" "b"))
  (check-false (js-string<? "b" "a"))
  (check-false (js-string<? "a" "a"))
  (check-true (js-string<? "" "a"))
  (check-false (js-string<? "a" ""))
  (check-false (js-string<? "" ""))
  (check-true (js-string<? "a" "ab"))
  (check-true (js-string<? "B" "a"))
  (check-true (js-string<? "a" e-acute))
  ;; An astral character sorts below U+E000..U+FFFF, the reverse of code-point order.
  (define private-use (chars #xE000))
  (define last-bmp (chars #xFFFF))
  (check-true (js-string<? face private-use))
  (check-true (js-string<? face last-bmp))
  (check-false (js-string<? private-use face))
  (check-true (string<? private-use face))
  (check-true (js-string<? (chars #xD7FF) face))
  (check-true (js-string<? linear-b face))
  (check-true (js-string<? (string-append "x" face) (string-append "x" last-bmp)))
  (check-equal? (sort (list last-bmp face "z" linear-b private-use "") js-string<?)
                (list "" "z" linear-b face private-use last-bmp))
  (check-exn exn:fail:contract? (lambda () (js-string<? "a" 'b))))

(test-case "js-number->string is String(n)"
  (define (prints-as n expected)
    (check-equal? (js-number->string n) expected))
  (prints-as 0 "0")
  (prints-as -0.0 "0")
  (prints-as 1 "1")
  (prints-as 1.0 "1")
  (prints-as -1.5 "-1.5")
  (prints-as 1/4 "0.25")
  (prints-as 123.456 "123.456")
  (prints-as 1e21 "1e+21")
  (prints-as 1e-7 "1e-7")
  (prints-as 1.23e-7 "1.23e-7")
  (prints-as 0.000001 "0.000001")
  (prints-as 999999999999999900000.0 "999999999999999900000")
  (prints-as 1e100 "1e+100")
  (prints-as 5e-324 "5e-324")
  (prints-as 2.2250738585072014e-308 "2.2250738585072014e-308")
  (prints-as 9007199254740993 "9007199254740992")
  (prints-as (expt 2 70) "1.1805916207174113e+21")
  (prints-as (- (expt 10 30)) "-1e+30")
  (prints-as +nan.0 "NaN")
  (prints-as +inf.0 "Infinity")
  (prints-as -inf.0 "-Infinity")
  (prints-as (expt 10 400) "Infinity")
  (check-exn exn:fail:contract? (lambda () (js-number->string "1")))
  (check-exn exn:fail:contract? (lambda () (js-number->string 1+2i))))
